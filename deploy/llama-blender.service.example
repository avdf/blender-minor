# Example systemd unit: a llama-server with a SMALL model that drives Blender through blender-minor.
# Copy it, edit the paths, the User and the blender-minor address, then:
#   sudo cp llama-blender.service.example /etc/systemd/system/llama-blender.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now llama-blender
#
# - mcp.json is the file from the README (the stdio bridge with --allow and --hide). Keep it next to the llama-server on a fast
#   disk: the bridge is a small Python file that llama-server starts itself.
# - llama-server finds the tools only when it STARTS. Two guards make that safe (copy both scripts next to mcp.json and make them executable):
#     wait-for-blender-minor.sh  ExecStartPre: waits until blender-minor LISTS ITS TOOLS (an open port is not enough);
#     check-llama-tools.sh       ExecStartPost: fails if the server found NO tools, so systemd starts it again. Found by a real reboot:
#                                on a loaded boot the discovery came back with 0 tools, the server looked healthy, and the model was useless.
[Unit]
Description=llama-server for Blender: small model + blender-minor tools
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/opt/llama/blender-minor
ExecStartPre=/opt/llama/blender-minor/wait-for-blender-minor.sh http://BLENDER_MINOR_HOST:9192/
ExecStart=/opt/llama/bin/llama-server \
  -m /opt/llama/models/Qwen3-1.7B-Q8_0.gguf \
  --host 0.0.0.0 --port 9931 \
  --jinja -c 8192 -np 1 \
  --mcp-servers-config /opt/llama/blender-minor/mcp.json
ExecStartPost=/opt/llama/blender-minor/check-llama-tools.sh 9931
TimeoutStartSec=300
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
